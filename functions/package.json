{
  "name": "functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Em Yeu Tieng Viet",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:rules": "node lib/tests/rules.test.js",
    "test": "node --test lib/tests/*.test.js"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@emytv/shared": "file:../shared",
    "@google/generative-ai": "^0.21.0",
    "cors": "^2.8.5",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  },
  "private": true
}
