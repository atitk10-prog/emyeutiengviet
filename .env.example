# ========================================================
# EM YÊU TIẾNG VIỆT - CẤU HÌNH BIẾN MÔI TRƯỜNG (ENVIRONMENT)
# ========================================================

# --- CẤU HÌNH WEB FRONTEND (web/.env) ---
# Thiết lập chế độ chạy (true = dùng Firebase Local Emulator, false = dùng Firebase Production)
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_EMULATOR_HOST=localhost

# Firebase Web App Credentials (lấy từ Firebase Console > Project Settings > General > Your apps)
VITE_FIREBASE_API_KEY=AIzaSyDemoDummyKeyForEmulatorUsageOnly123
VITE_FIREBASE_AUTH_DOMAIN=em-yeu-tieng-viet-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=em-yeu-tieng-viet-demo
VITE_FIREBASE_STORAGE_BUCKET=em-yeu-tieng-viet-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# --- CẤU HÌNH CLOUD FUNCTIONS & AI (functions/.env) ---
# Khóa API cho AI (Gemini API Key hoặc OpenAI API Key)
# Tuyệt đối KHÔNG đưa vào frontend hoặc commit lên Git!
# Trong môi trường Production, khuyến nghị dùng: firebase functions:secrets:set GEMINI_API_KEY
GEMINI_API_KEY=
OPENAI_API_KEY=

# Cấu hình AI Provider ('gemini' hoặc 'openai')
AI_PROVIDER=gemini
