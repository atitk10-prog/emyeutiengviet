# ========================================================
# EM YÊU TIẾNG VIỆT - CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (ENV TEMPLATE)
# ========================================================
# LƯU Ý BẢO MẬT:
# - KHÔNG điền giá trị thật vào tệp này. Tệp này được lưu trên Git làm mẫu cấu hình.
# - Mọi khóa bí mật (Private Key, Service Account, Gemini API Key) chỉ cấu hình trên:
#   + Cục bộ: tệp .env.local (đã nằm trong .gitignore)
#   + Online: Vercel Project Settings > Environment Variables
# ========================================================

# --------------------------------------------------------
# 1. FRONTEND CLIENT (web/.env hoặc Vercel Frontend Environment)
# Tất cả biến bắt đầu bằng VITE_ sẽ được đóng gói vào client bundle công khai.
# TUYỆT ĐỐI KHÔNG ĐƯA PRIVATE KEY / SECRET VÀO CÁC BIẾN VITE_!
# --------------------------------------------------------

# Chế độ kết nối Backend:
# - VITE_USE_FIREBASE_EMULATOR=true  : Chạy với Firebase Emulator cục bộ (mặc định cho dev)
# - VITE_USE_FIREBASE_EMULATOR=false : Chạy với Firebase Cloud Production
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_EMULATOR_HOST=localhost

# Chế độ gọi API qua Vercel Serverless Functions (/api/*)
# - true : Giao tiếp với các endpoint /api/* trên Vercel
# - false: Gọi trực tiếp Firebase Callable Functions (chế độ Emulator)
VITE_USE_VERCEL_API=false

# Firebase Web App Config (Thông tin public an toàn từ Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=AIzaSyDemoDummyKeyForEmulatorUsageOnly123
VITE_FIREBASE_AUTH_DOMAIN=em-yeu-tieng-viet-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=em-yeu-tieng-viet-demo
VITE_FIREBASE_STORAGE_BUCKET=em-yeu-tieng-viet-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# --------------------------------------------------------
# 2. SERVER-SIDE BACKEND (Vercel Functions / Cloud Functions)
# Các biến dưới đây CHỈ chạy trên Server, KHÔNG bao giờ lộ ra trình duyệt.
# --------------------------------------------------------

# Môi trường chạy ('development' hoặc 'production')
NODE_ENV=development

# Firebase Admin SDK Service Account (Khởi tạo quyền Admin phía Server trên Vercel)
# Cách 1 (Khuyến nghị): Toàn bộ nội dung JSON của Service Account (hoặc chuỗi Base64 của file JSON)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Cách 2: Nhập từng thông số riêng lẻ nếu không dùng JSON đầy đủ
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Mã bảo mật tối cao để bootstrap tài khoản Quản trị viên (Admin) lần đầu tiên
# Bắt buộc phải cấu hình giá trị bí mật phức tạp khi triển khai Production!
ADMIN_BOOTSTRAP_SECRET=

# Danh sách email giáo viên được phép kích hoạt tự động (phân tách bởi dấu phẩy)
TEACHER_EMAIL_ALLOWLIST=

# Trí tuệ nhân tạo Gemini API Key (Chỉ chạy ở Backend Vercel Functions)
GEMINI_API_KEY=

# AI Provider ('gemini' hoặc 'openai')
AI_PROVIDER=gemini
