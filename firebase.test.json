{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": []
    }
  ],
  "emulators": {
    "auth": {
      "port": 9199
    },
    "functions": {
      "port": 5101
    },
    "firestore": {
      "port": 8180
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
